# La Portada y las sugerencias de fuentes usan la API de Claude.
# Sin esta clave el resto de la aplicación funciona igual: la portada
# sale en orden cronológico en vez de editada.
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: a quién va dirigida la portada. Ayuda al modelo a decidir
# qué destacar y con qué tono escribir.
# MENTATNEWS_PERFIL=una persona que sigue de cerca la tecnología y los mercados
