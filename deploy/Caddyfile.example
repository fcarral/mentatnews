# MentatNews no tiene login propio: la autenticación la pone el proxy.
# Este ejemplo delega en un servicio de autenticación externo y deja pasar
# sin él las peticiones de API que traen su propia clave.

news.ejemplo.com {
	# Los tuits que citan los artículos se resuelven en el servidor y se pintan
	# aquí dentro. El vídeo se sirve desde el CDN de X, así que media-src tiene
	# que permitirlo; si tu política es más cerrada, el resto del tuit —texto,
	# autor y fotos— se ve igual.
	header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; media-src 'self' https://video.twimg.com; connect-src 'self'; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

	# Las peticiones con X-API-Key las valida la propia aplicación
	@apikey {
		header X-API-Key *
		path /api/*
	}
	handle @apikey {
		reverse_proxy localhost:9160
	}

	# Todo lo demás pasa por tu autenticación
	handle {
		forward_auth localhost:9120 {
			uri /validate
		}
		reverse_proxy localhost:9160
	}

	# La aplicación cambia a menudo: que nadie fije el HTML ni el JS
	@volatil path / /index.html /static/app.js /static/app.css
	header @volatil Cache-Control "no-store, must-revalidate"

	encode gzip
}
